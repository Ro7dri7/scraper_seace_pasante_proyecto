# Copia a .env y completa las claves. No subas .env al git.

TWOCAPTCHA_API_KEY=

# --- IPRoyal residencial (Country: PE, Pay As You Go) ---
# Si el usuario del dashboard ya trae _country-pe, deja PROXY_COUNTRY vacío.
PROXY_ENABLED=1
PROXY_SCHEME=http
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USER=tu_usuario_de_iproyal
PROXY_PASS=tu_contraseña
PROXY_COUNTRY=PE
PROXY_TYPE=HTTP

SEACE_RECAPTCHA_VERSION=v3
SEACE_RECAPTCHA_SITEKEY=6Lfhnb0pAAAAAB3RxPrOlihIByQUBjpZCAjX-cY2
SEACE_RECAPTCHA_ACTION=frmBuscadorProcedimientosSeleccion
SEACE_RECAPTCHA_MIN_SCORE=0.3

SEACE_HOST=https://prod2.seace.gob.pe
SEACE_ALFRESCO=https://alfprod.seace.gob.pe/alfresco
SEACE_VERSION=Seace 3
SEACE_IP_CLIENTE=

SEACE_MODO=sync
SEACE_YEAR=2026
SEACE_FECHA_INICIO=01/08/2026
SEACE_FECHA_FIN=31/08/2026
SEACE_OBJETO=

SEACE_DIAS_LOOKBACK=3
SEACE_DIAS_SOLAPE=1
SEACE_ROWS=20
SEACE_SLEEP_SEC=1.2
SEACE_MAX_PAGES=
SEACE_GUARDAR_XML=false

SEACE_PROCESAR_FICHAS=true
# Vacío = sin tope (producción). Pon 3 o 5 solo para pruebas.
SEACE_MAX_FICHAS=

SEACE_DB_FILE=seace.db
SEACE_NUEVAS_FILE=nuevas.json
SEACE_FICHA_DIR=fichas
SEACE_TOKEN_FILE=token.txt
# Solo para depurar el parser de fichas. No se descargan PDFs/ZIPs nunca.
SEACE_GUARDAR_FICHA_HTML=false

# --- SEACE PROD6: Compras Menores (<= 8 UIT), API REST sin CAPTCHA ---
PROD6_BASE=https://prod6.seace.gob.pe/v1/s8uit-services/buscadorpublico/contrataciones
# Vacío = año en curso
PROD6_ANIO=
PROD6_ESTADO=2
PROD6_ORDEN=2
PROD6_PAGE_SIZE=100
PROD6_SLEEP_SEC=0.4
PROD6_WORKERS=6
PROD6_TIMEOUT=60
PROD6_REINTENTOS=3
# Corte del delta: páginas seguidas sin nomenclaturas nuevas
PROD6_PAGINAS_SIN_NUEVOS=3
PROD6_MAX_PAGES=
PROD6_MAX_DETALLES=
PROD6_ARCHIVOS_BASE=https://prod6.seace.gob.pe/v1/s8uit-services/archivo/archivos-publico

# Enriquecer RUC con RNP+SUNAT antes de insertar en proveedores (1=sí)
ENRIQUECER_PROVEEDORES=1
ENRIQUECER_WORKERS=20

# Posta OECE local (deduplicación). Relativo a este proyecto.
OECE_HANDOFF_FILE=handoff_state.json

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- Microservicio on-demand (api_desbloqueo.py) ---
# Cliente OpenAI-compatible. Vacío = https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# KeyAI / otros: la base URL que indique el agregador
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
DESBLOQUEO_HOST=0.0.0.0
DESBLOQUEO_PORT=8080
DESBLOQUEO_MAX_PALABRAS=1000
DESBLOQUEO_MAX_BYTES=41943040
DESBLOQUEO_HTTP_TIMEOUT=90

# Embudo de ahorro (radar SEACE en horas; 48–72)
EMBUDO_HORAS_RADAR=72
